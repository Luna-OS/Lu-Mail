<Project>
  <!-- Gemeinsame Einstellungen für alle Lu-Mail-Projekte unter windows/ -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>Lu-Mail</Company>
    <Product>Lu-Mail</Product>
    <!-- Die CI setzt beim Release -p:Version=1.2.3 -->
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
