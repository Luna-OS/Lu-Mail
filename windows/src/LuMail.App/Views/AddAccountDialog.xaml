<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LuMail.App.Views.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Konto hinzufügen"
    PrimaryButtonText="Weiter"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="480">
        <!-- ===== Schritt 1: E-Mail-Adresse oder Anbieter ===== -->
        <StackPanel x:Name="Step1Panel" Spacing="8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Wie lautet deine E-Mail-Adresse?" />
            <TextBox x:Name="EmailBox" FontSize="16" InputScope="EmailSmtpAddress" KeyDown="OnEmailKeyDown"
                     PlaceholderText="name@beispiel.de" TextChanged="OnEmailChanged" />
            <StackPanel x:Name="DiscoveringPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <ProgressRing Width="16" Height="16" IsActive="True" />
                <TextBlock x:Name="DiscoveringText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" Text="Oder Anbieter direkt wählen:" />
            <Grid x:Name="ProviderGrid" ColumnSpacing="8" RowSpacing="8" />
        </StackPanel>

        <!-- ===== Schritt 2: Anbieter-Seite ===== -->
        <Grid x:Name="Step2Panel" RowSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ProviderBadge" Width="40" Height="40" CornerRadius="20">
                    <TextBlock x:Name="ProviderInitial" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="Bold" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProviderNameText" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" />
                    <TextBlock x:Name="ProviderEmailText" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <!-- Web-Anmeldung (Standard, §20) -->
            <StackPanel x:Name="WebModePanel" Grid.Row="1" Padding="12,10,12,12" Background="{ThemeResource LuSurfaceHover}"
                        CornerRadius="{StaticResource LuRadiusMedium}" Spacing="6" Visibility="Collapsed">
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" TextWrapping="Wrap"
                           Text="Ganz normal mit deinem Passwort – kein App-Passwort, keine Bridge nötig." />
                <TextBlock x:Name="WebModeDetail" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="GuidePanel" Grid.Row="1" Spacing="6">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="So geht's" />
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StepsPanel" Padding="0,0,8,0" Spacing="10" />
                </ScrollViewer>
            </StackPanel>
            <Grid x:Name="BridgePanel" Grid.Row="2" Padding="10,6,6,6" Background="{ThemeResource LuSurfaceHover}"
                  CornerRadius="{StaticResource LuRadiusSmall}" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BridgeText" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
                <HyperlinkButton Grid.Column="1" Click="OnRecheckBridgeClick" Content="Erneut prüfen" />
            </Grid>
            <TextBlock x:Name="ServersText" Grid.Row="3" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" Visibility="Collapsed" />
            <InfoBar x:Name="HintBar" Grid.Row="4" IsClosable="False" IsOpen="False" Severity="Informational" />
            <HyperlinkButton x:Name="ModeLink" Grid.Row="5" Padding="0,2,0,2" Click="OnModeLinkClick" FontSize="12" Visibility="Collapsed" />
        </Grid>

        <!-- ===== Warten auf den Browser ===== -->
        <StackPanel x:Name="WaitingPanel" Margin="0,24,0,24" HorizontalAlignment="Center" Spacing="14" Visibility="Collapsed">
            <ProgressRing Width="48" Height="48" HorizontalAlignment="Center" IsActive="True" />
            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource LuTextPrimary}" Text="Bitte im Browser fortfahren …" />
            <TextBlock x:Name="WaitingDetail" MaxWidth="400" HorizontalAlignment="Center"
                       Foreground="{ThemeResource LuTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Click="OnCancelWaitingClick" Content="Abbrechen" />
        </StackPanel>

        <!-- ===== Erfolg ===== -->
        <StackPanel x:Name="SuccessPanel" Margin="0,32,0,32" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <FontIcon HorizontalAlignment="Center" FontSize="48" Foreground="{ThemeResource LuSuccess}" Glyph="&#xE73E;" />
            <TextBlock x:Name="SuccessText" MaxWidth="420" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource LuTextPrimary}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
