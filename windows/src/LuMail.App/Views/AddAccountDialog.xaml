<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="LuMail.App.Views.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LuMail.App.ViewModels"
    mc:Ignorable="d"
    Title="Konto hinzufügen"
    CloseButtonText="Abbrechen"
    DefaultButton="None"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <DataTemplate x:Key="ProviderTileTemplate" x:DataType="vm:ProviderTile">
            <Grid Width="200" Height="96" Padding="14,12,14,12" Background="{x:Bind Brush}" CornerRadius="{StaticResource LuRadiusMedium}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="#33FFFFFF" CornerRadius="16">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                               Foreground="White" Text="{x:Bind Initial}" />
                </Border>
                <StackPanel Grid.Row="1" Spacing="0">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="{x:Bind Name}" />
                    <TextBlock FontSize="11" Foreground="#DDFFFFFF" Text="{x:Bind MethodText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid MinWidth="440" MaxWidth="460">
        <!-- Auswahl -->
        <StackPanel x:Name="ChoosePanel" Spacing="12">
            <TextBlock Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap"
                       Text="Wähle deinen Anbieter. Die Anmeldung erfolgt immer in deinem Standardbrowser – Lu-Mail sieht dein Passwort nur, wenn der Anbieter kein OAuth anbietet." />
            <GridView x:Name="ProviderGrid" IsItemClickEnabled="False" ItemTemplate="{StaticResource ProviderTileTemplate}"
                      SelectionChanged="OnProviderSelectionChanged" SelectionMode="Single" />
            <TextBox x:Name="EmailBox" Header="E-Mail-Adresse (optional)" InputScope="EmailSmtpAddress"
                     PlaceholderText="name@beispiel.de" TextChanged="OnEmailChanged" />
            <InfoBar x:Name="HintBar" IsClosable="False" IsOpen="False" Severity="Informational" />
            <InfoBar x:Name="ErrorBar" IsClosable="True" IsOpen="False" Severity="Error" Title="Anmeldung fehlgeschlagen" />
            <Button x:Name="LoginButton" HorizontalAlignment="Stretch" Click="OnLoginClick" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                    <TextBlock Text="Im Browser anmelden" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Warten auf den Browser -->
        <StackPanel x:Name="WaitingPanel" Margin="0,24,0,24" HorizontalAlignment="Center" Spacing="14" Visibility="Collapsed">
            <ProgressRing Width="48" Height="48" HorizontalAlignment="Center" IsActive="True" />
            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource LuTextPrimary}" Text="Bitte im Browser fortfahren…" />
            <TextBlock x:Name="WaitingDetail" MaxWidth="380" HorizontalAlignment="Center"
                       Foreground="{ThemeResource LuTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Click="OnCancelWaitingClick" Content="Abbrechen" />
        </StackPanel>
    </Grid>
</ContentDialog>
