<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LuMail.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource LuBackground}">


    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False"
                    OpenPaneLength="210" PaneDisplayMode="Left" SelectionChanged="OnNavSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Allgemein" Tag="general">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Darstellung" Tag="appearance">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Konten" Tag="accounts">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Regeln" Tag="rules">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Datenschutz" Tag="privacy">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE72E;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Updates" Tag="updates">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE895;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid MaxWidth="760" Padding="28,20,20,12" HorizontalAlignment="Stretch">
            <ScrollViewer x:Name="GeneralSection" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Padding="0,0,12,16" Spacing="16">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Allgemein" />
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Automatisch abrufen" />
                        <ComboBox x:Name="IntervalBox" MinWidth="220" SelectionChanged="OnIntervalChanged" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap"
                                   Text="Konten mit IMAP IDLE melden neue Nachrichten zusätzlich sofort (Push)." />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotificationsSwitch" Header="Mitteilungen" OffContent="Aus" OnContent="An" Toggled="OnNotificationsToggled" />
                    <ToggleSwitch x:Name="CategoriesSwitch" Header="Kategorien im Posteingang trennen" OffContent="Aus" OnContent="An" Toggled="OnCategoriesToggled" />
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="CacheSwitch" Header="Offline-Cache" OffContent="Aus" OnContent="An" Toggled="OnCacheToggled" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="OnClearCacheClick" Content="Cache leeren" />
                            <TextBlock x:Name="CacheSizeText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Automatisch aufräumen" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap"
                                   Text="Ältere, nicht markierte Nachrichten dieser Kategorien werden archiviert (ohne Archiv: Papierkorb)." />
                        <StackPanel x:Name="CleanupPanel" Spacing="6" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Datenordner" />
                        <TextBlock x:Name="DataFolderText" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <HyperlinkButton Click="OnOpenDataFolderClick" Content="Ordner öffnen (oauth.json, accounts.json, rules.json)" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="AppearanceSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Padding="0,0,12,16" Spacing="16">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Darstellung" />
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Modus" />
                        <ComboBox x:Name="ModeBox" MinWidth="220" SelectionChanged="OnAppearanceChanged" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Variante" />
                        <ComboBox x:Name="VariantBox" MinWidth="220" SelectionChanged="OnAppearanceChanged" />
                        <TextBlock x:Name="VariantDescription" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Akzentfarbe" />
                        <ComboBox x:Name="AccentBox" MinWidth="220" SelectionChanged="OnAppearanceChanged" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <ToggleSwitch x:Name="NightSkySwitch" Header="Animierter Nachthimmel" OffContent="Aus" OnContent="An" Toggled="OnNightSkyToggled" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap"
                                   Text="Sterne und Mond hinter Seitenleiste und Liste (im hellen Modus nur auf dem Willkommens- und Sperrbildschirm). Steht still, wenn die Windows-Animationen ausgeschaltet sind." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="AccountsSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Padding="0,0,12,16" Spacing="12">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Konten" />
                    <TextBlock x:Name="NoAccountsText" Foreground="{ThemeResource LuTextSecondary}" Text="Noch keine Konten eingerichtet." Visibility="Collapsed" />
                    <StackPanel x:Name="AccountsPanel" Spacing="14" />
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="RulesSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Padding="0,0,12,16" Spacing="16">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Regeln" />
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Absender" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap"
                                   Text="„Absender immer als … einsortieren“ gewinnt vor allen anderen Regeln." />
                        <StackPanel x:Name="SendersPanel" Spacing="4" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Regeln (erste passende gewinnt)" />
                        <StackPanel x:Name="RulesPanel" Spacing="4" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RuleFieldBox" MinWidth="120" />
                            <TextBox x:Name="RuleContainsBox" Grid.Column="1" PlaceholderText="enthält …" />
                            <ComboBox x:Name="RuleCategoryBox" Grid.Column="2" MinWidth="150" />
                            <Button Grid.Column="3" Click="OnAddRuleClick" Content="Hinzufügen" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Eigene Kategorien" />
                        <StackPanel x:Name="CustomCategoriesPanel" Spacing="4" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CategoryNameBox" PlaceholderText="Name, z. B. Rechnungen" />
                            <ComboBox x:Name="CategoryColorBox" Grid.Column="1" MinWidth="130" />
                            <Button Grid.Column="2" Click="OnAddCategoryClick" Content="Anlegen" />
                        </Grid>
                        <TextBlock x:Name="RulesStatusText" FontSize="12" Foreground="{ThemeResource LuDanger}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PrivacySection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Padding="0,0,12,16" Spacing="16">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Datenschutz" />
                    <StackPanel Spacing="4">
                        <ToggleSwitch x:Name="ExternalSwitch" Header="Externe Bilder immer laden" OffContent="Aus (empfohlen)" OnContent="An" Toggled="OnExternalToggled" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap"
                                   Text="Externe Bilder können verraten, wann und wo du eine E-Mail geöffnet hast (Tracking-Pixel)." />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <ToggleSwitch x:Name="LockSwitch" Header="Lu-Mail sperren mit Windows Hello" OffContent="Aus" OnContent="An" Toggled="OnLockToggled" />
                        <ComboBox x:Name="LockMinutesBox" MinWidth="260" SelectionChanged="OnLockMinutesChanged" />
                        <TextBlock x:Name="LockHintText" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="UpdatesSection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Padding="0,0,12,16" Spacing="8">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}" Text="Updates" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" />
                <ComboBox x:Name="UpdateModeBox" MinWidth="220" SelectionChanged="OnUpdateModeChanged" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CheckUpdatesButton" Click="OnCheckUpdatesClick" Content="Jetzt nach Updates suchen" />
                    <ProgressRing x:Name="CheckUpdatesRing" Width="20" Height="20" IsActive="False" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
