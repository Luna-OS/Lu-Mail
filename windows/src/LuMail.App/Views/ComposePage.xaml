<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LuMail.App.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource LuSurface}">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="OnSendAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="16,0,0,0" Background="Transparent">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="14" Foreground="{ThemeResource LuMoon}" Glyph="&#xE708;" />
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource LuTextPrimary}" Text="Neue E-Mail" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="20,8,20,8" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="{ThemeResource LuTextSecondary}" Text="Von" />
            <ComboBox x:Name="FromBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnFromChanged" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{ThemeResource LuTextSecondary}" Text="An" />
            <AutoSuggestBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" PlaceholderText="empfaenger@beispiel.de, weitere@beispiel.de"
                            SuggestionChosen="OnAddressSuggestionChosen" TextChanged="OnAddressTextChanged" UpdateTextOnSelect="False" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{ThemeResource LuTextSecondary}" Text="Cc" />
            <AutoSuggestBox x:Name="CcBox" Grid.Row="2" Grid.Column="1"
                            SuggestionChosen="OnAddressSuggestionChosen" TextChanged="OnAddressTextChanged" UpdateTextOnSelect="False" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{ThemeResource LuTextSecondary}" Text="Bcc" />
            <AutoSuggestBox x:Name="BccBox" Grid.Row="3" Grid.Column="1"
                            SuggestionChosen="OnAddressSuggestionChosen" TextChanged="OnAddressTextChanged" UpdateTextOnSelect="False" />

            <TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{ThemeResource LuTextSecondary}" Text="Betreff" />
            <TextBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1" TextChanged="OnSubjectChanged" />
        </Grid>

        <TextBox x:Name="BodyBox" Grid.Row="2" Margin="20,4,20,8" AcceptsReturn="True"
                 FontFamily="{StaticResource LuFontFamily}" IsSpellCheckEnabled="True"
                 PlaceholderText="Nachricht schreiben…" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" />

        <!-- Anhänge -->
        <StackPanel Grid.Row="3" Margin="20,0,20,4" Spacing="4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                <StackPanel x:Name="AttachmentsPanel" Orientation="Horizontal" Spacing="8" />
            </ScrollViewer>
            <TextBlock x:Name="AttachmentHint" FontSize="12" Foreground="{ThemeResource LuDanger}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="4" Padding="20,8,20,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="OnAddAttachmentClick" ToolTipService.ToolTip="Dateien anhängen (auch per Drag &amp; Drop)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE723;" />
                    <TextBlock Text="Anhang" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource LuDanger}" TextWrapping="Wrap" />
            <ProgressRing x:Name="SendingRing" Grid.Column="2" Width="20" Height="20" IsActive="False" />
            <Button x:Name="ScheduleButton" Grid.Column="3" Click="OnScheduleClick" Content="Später senden …" />
            <Button x:Name="SendButton" Grid.Column="4" Click="OnSendClick" Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Senden (Strg+Eingabe)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                    <TextBlock Text="Senden" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
