<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LuMail.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LuMail.App.ViewModels"
    xmlns:views="using:LuMail.App.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- ===== Sidebar-Vorlagen ===== -->
        <DataTemplate x:Key="SidebarSectionTemplate" x:DataType="vm:SidebarItem">
            <TextBlock Margin="10,14,0,4" FontSize="11" FontWeight="SemiBold"
                       Foreground="{ThemeResource LuTextMuted}" Text="{x:Bind Title}" />
        </DataTemplate>

        <DataTemplate x:Key="SidebarProviderTemplate" x:DataType="vm:SidebarItem">
            <Grid Height="30" Margin="0,12,0,0">
                <Border Background="{ThemeResource LuSurfaceSelected}" CornerRadius="{StaticResource LuRadiusSmall}"
                        Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                <Grid Padding="10,0,8,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{x:Bind DotBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource LuTextSecondary}" Text="{x:Bind Title}" />
                    <Border Grid.Column="2" MinWidth="20" Padding="7,1,7,2" VerticalAlignment="Center"
                            Background="{ThemeResource LuAccent}" CornerRadius="9" Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource LuAccentText}" Text="{x:Bind UnreadText, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SidebarAccountTemplate" x:DataType="vm:SidebarItem">
            <Grid Margin="{x:Bind Indent}" Padding="10,6,8,2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}"
                           Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="13" Foreground="{ThemeResource LuDanger}" Glyph="&#xE7BA;"
                              ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}"
                              Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                    <Border MinWidth="20" Padding="7,1,7,2" VerticalAlignment="Center" Background="{ThemeResource LuAccent}"
                            CornerRadius="9" Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource LuAccentText}" Text="{x:Bind UnreadText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SidebarFolderTemplate" x:DataType="vm:SidebarItem">
            <Grid Height="32" Margin="{x:Bind Indent}">
                <Border Background="{ThemeResource LuSurfaceSelected}" CornerRadius="{StaticResource LuRadiusSmall}"
                        Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                <Grid Padding="10,0,8,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LuTextSecondary}" Glyph="{x:Bind Glyph}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource LuTextPrimary}"
                               Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" MinWidth="20" Padding="7,1,7,2" VerticalAlignment="Center"
                            Background="{ThemeResource LuAccent}" CornerRadius="9"
                            Visibility="{x:Bind BadgeVisibility, Mode=OneWay}">
                        <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource LuAccentText}" Text="{x:Bind UnreadText, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <views:SidebarTemplateSelector x:Key="SidebarTemplateSelector"
                                       SectionTemplate="{StaticResource SidebarSectionTemplate}"
                                       ProviderTemplate="{StaticResource SidebarProviderTemplate}"
                                       AccountTemplate="{StaticResource SidebarAccountTemplate}"
                                       FolderTemplate="{StaticResource SidebarFolderTemplate}" />

        <!-- ===== Nachrichtenliste ===== -->
        <DataTemplate x:Key="MessageTemplate" x:DataType="vm:MessageItem">
            <Grid Padding="0,10,10,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{x:Bind ProviderBrush}" RadiusX="1.5" RadiusY="1.5"
                           ToolTipService.ToolTip="{x:Bind AccountEmail}" />
                <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,6,0,0" VerticalAlignment="Top"
                         Fill="{ThemeResource LuUnreadDot}" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Spacing="2">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="{x:Bind SenderWeight, Mode=OneWay}" Foreground="{ThemeResource LuTextPrimary}"
                                   Text="{x:Bind ParticipantsText}" TextTrimming="CharacterEllipsis" />
                        <FontIcon Grid.Column="1" FontSize="12" Foreground="{ThemeResource LuDanger}" Glyph="&#xE7C1;"
                                  Visibility="{x:Bind FlagVisibility, Mode=OneWay}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Border Padding="6,0,6,1" VerticalAlignment="Center" Background="{ThemeResource LuSurfaceSelected}"
                                    CornerRadius="8" Visibility="{x:Bind ThreadVisibility}">
                                <TextBlock FontSize="11" Foreground="{ThemeResource LuTextSecondary}" Text="{x:Bind ThreadCountText}" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LuTextMuted}" Text="{x:Bind DateText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="13" FontWeight="{x:Bind SubjectWeight, Mode=OneWay}" Foreground="{ThemeResource LuTextPrimary}"
                               Text="{x:Bind Subject}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource LuAccent}" Text="{x:Bind InfoText, Mode=OneWay}"
                               Visibility="{x:Bind InfoVisibility, Mode=OneWay}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource LuTextSecondary}" MaxLines="2" Text="{x:Bind Preview}"
                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    <Border Margin="0,3,0,0" Padding="7,1,7,2" HorizontalAlignment="Left"
                            Background="{x:Bind CategoryBrush, Mode=OneWay}" CornerRadius="{StaticResource LuRadiusSmall}"
                            Visibility="{x:Bind CategoryVisibility, Mode=OneWay}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{x:Bind CategoryName, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MessageHeaderTemplate" x:DataType="vm:MessageItem">
            <TextBlock Margin="4,14,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource LuTextMuted}" Text="{x:Bind HeaderText}" />
        </DataTemplate>

        <views:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                       MessageTemplate="{StaticResource MessageTemplate}"
                                       HeaderTemplate="{StaticResource MessageHeaderTemplate}" />

        <Style x:Key="SidebarItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="MessageItemContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="6,0,6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource LuSidebar}" CharacterReceived="OnRootCharacterReceived">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewMailAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Eigene Titelleiste ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" Background="Transparent">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <FontIcon FontSize="16" Foreground="{ThemeResource LuMoon}" Glyph="&#xE708;" />
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{ThemeResource LuTextPrimary}" Text="Lu-Mail" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Grid Grid.Column="0" Padding="8,0,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="NewMailButton" Margin="4,4,4,6" HorizontalAlignment="Stretch"
                        Click="OnNewMailClick" Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Neue E-Mail (Strg+N)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Neue E-Mail" />
                    </StackPanel>
                </Button>

                <ListView x:Name="SidebarList" Grid.Row="1"
                          IsItemClickEnabled="True" ItemClick="OnSidebarItemClick" SelectionMode="None"
                          ItemContainerStyle="{StaticResource SidebarItemContainerStyle}"
                          ItemTemplateSelector="{StaticResource SidebarTemplateSelector}" />

                <Grid Grid.Row="2" Margin="4,8,4,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Stretch" Click="OnAddAccountClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8FA;" />
                            <TextBlock Text="Konto hinzufügen" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="OnRefreshClick" ToolTipService.ToolTip="Aktualisieren (F5)">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button Grid.Column="2" Click="OnSettingsClick" ToolTipService.ToolTip="Einstellungen">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                    </Button>
                </Grid>
            </Grid>

            <!-- ===== Web-Konto (eingebettetes Webmail, §20) – liegt hinter Liste und Leseansicht ===== -->
            <Grid x:Name="WebPanel" Grid.Column="1" Grid.ColumnSpan="2" Background="{ThemeResource LuSurface}"
                  BorderBrush="{ThemeResource LuBorder}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="10,6,12,6" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="WebBackButton" Click="OnWebBackClick" ToolTipService.ToolTip="Zurück">
                        <FontIcon FontSize="13" Glyph="&#xE72B;" />
                    </Button>
                    <Button x:Name="WebForwardButton" Grid.Column="1" Click="OnWebForwardClick" ToolTipService.ToolTip="Vor">
                        <FontIcon FontSize="13" Glyph="&#xE72A;" />
                    </Button>
                    <Button Grid.Column="2" Click="OnWebReloadClick" ToolTipService.ToolTip="Neu laden">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                    </Button>
                    <TextBlock x:Name="WebAccountText" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource LuTextSecondary}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <InfoBar x:Name="WebInfoBar" Grid.Row="1" Margin="10,0,10,6" IsClosable="True" IsOpen="False" Severity="Informational" />
                <Grid x:Name="WebHost" Grid.Row="2" />
            </Grid>

            <!-- ===== Nachrichtenliste ===== -->
            <Grid x:Name="ListPane" Grid.Column="1" Background="{ThemeResource LuBackground}" BorderBrush="{ThemeResource LuBorder}"
                  BorderThickness="1,1,1,0" CornerRadius="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Padding="18,14,18,10" Spacing="2">
                    <TextBlock x:Name="ListTitleText" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource LuTextPrimary}" Text="Alle Posteingänge" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ListSubtitleText" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" />
                            <TextBlock x:Name="OfflineText" FontSize="12" Foreground="{ThemeResource LuDanger}"
                                       Text="Offline – Anzeige aus dem Cache" Visibility="Collapsed" />
                        </StackPanel>
                        <ToggleButton x:Name="ConversationToggle" Grid.Column="1" Click="OnConversationToggleClick"
                                      ToolTipService.ToolTip="Nachrichten als Konversationen gruppieren">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE8BD;" />
                                <TextBlock FontSize="12" Text="Als Konversationen" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                    <AutoSuggestBox x:Name="SearchBox" Margin="0,10,0,0" PlaceholderText="Suchen – Enter sucht auch auf dem Server"
                                    QueryIcon="Find" QuerySubmitted="OnSearchQuerySubmitted" TextChanged="OnSearchTextChanged" />
                </StackPanel>

                <ProgressBar x:Name="BusyBar" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" />

                <ListView x:Name="MessageList" Grid.Row="2" SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource MessageItemContainerStyle}"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                          SelectionChanged="OnMessageSelectionChanged" />

                <!-- Mehrfachauswahl -->
                <Grid x:Name="BulkBar" Grid.Row="2" Margin="10" Padding="10,6,10,6" VerticalAlignment="Bottom"
                      Background="{ThemeResource LuSurface}" BorderBrush="{ThemeResource LuBorder}" BorderThickness="1"
                      CornerRadius="{StaticResource LuRadiusMedium}" Visibility="Collapsed">
                    <StackPanel Orientation="Vertical" Spacing="6">
                        <TextBlock x:Name="BulkText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource LuTextSecondary}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Click="OnBulkSeenClick" ToolTipService.ToolTip="Gelesen">
                                <FontIcon FontSize="14" Glyph="&#xE8C3;" />
                            </Button>
                            <Button Click="OnBulkUnseenClick" ToolTipService.ToolTip="Ungelesen">
                                <FontIcon FontSize="14" Glyph="&#xE715;" />
                            </Button>
                            <Button Click="OnBulkFlagClick" ToolTipService.ToolTip="Markieren">
                                <FontIcon FontSize="14" Glyph="&#xE7C1;" />
                            </Button>
                            <Button Click="OnBulkArchiveClick" ToolTipService.ToolTip="Archivieren">
                                <FontIcon FontSize="14" Glyph="&#xE7B8;" />
                            </Button>
                            <Button Click="OnBulkDeleteClick" ToolTipService.ToolTip="Löschen">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                            <Button Click="OnBulkSpamClick" ToolTipService.ToolTip="Spam">
                                <FontIcon FontSize="14" Glyph="&#xE730;" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="0,40,0,0" HorizontalAlignment="Center"
                           Foreground="{ThemeResource LuTextMuted}" Text="Keine Nachrichten" Visibility="Collapsed" />

                <StackPanel x:Name="WelcomePanel" Grid.Row="2" MaxWidth="300" Margin="24" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
                    <FontIcon HorizontalAlignment="Center" FontSize="44" Foreground="{ThemeResource LuMoon}" Glyph="&#xE708;" />
                    <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource LuTextPrimary}" Text="Willkommen bei Lu-Mail" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource LuTextSecondary}" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Füge dein erstes Konto hinzu – Gmail, Proton Mail, Mail.ru oder Hostinger. Die Anmeldung läuft sicher in deinem Browser." />
                    <Button HorizontalAlignment="Center" Click="OnAddAccountClick" Content="Konto hinzufügen"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <!-- ===== Leseansicht ===== -->
            <Grid x:Name="ReaderPane" Grid.Column="2" Background="{ThemeResource LuSurface}" BorderBrush="{ThemeResource LuBorder}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="ReaderPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon HorizontalAlignment="Center" FontSize="48" Foreground="{ThemeResource LuTextMuted}" Glyph="&#xE715;" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource LuTextMuted}" Text="Keine Nachricht ausgewählt" />
                </StackPanel>

                <Grid x:Name="ReaderPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Kopfbereich -->
                    <StackPanel Padding="24,18,24,6" Spacing="6">
                        <TextBlock x:Name="ReaderSubject" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ReaderAvatar" Width="36" Height="36" VerticalAlignment="Top" CornerRadius="18">
                                <TextBlock x:Name="ReaderAvatarText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock x:Name="ReaderFrom" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}"
                                           IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ReaderTo" FontSize="12" Foreground="{ThemeResource LuTextSecondary}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                <TextBlock x:Name="ReaderDate" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource LuTextMuted}" />
                                <Border x:Name="ReaderAccountChip" Padding="8,1,8,2" HorizontalAlignment="Right" CornerRadius="{StaticResource LuRadiusSmall}">
                                    <TextBlock x:Name="ReaderAccountText" FontSize="11" Foreground="White" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Aktionsleiste -->
                    <CommandBar x:Name="ReaderCommands" Grid.Row="1" Margin="12,0,12,0" HorizontalAlignment="Left"
                                Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                        <AppBarButton Click="OnReplyClick" Label="Antworten">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8CA;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Click="OnReplyAllClick" Label="Allen antworten">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8C2;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Click="OnForwardClick" Label="Weiterleiten">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE72A;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="ArchiveButton" Click="OnArchiveClick" Label="Archivieren">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE7B8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="DeleteButton" Click="OnDeleteClick" Label="Löschen">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="SpamButton" Click="OnSpamClick" Label="Spam">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE730;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="FlagButton" Click="OnFlagClick" Label="Markieren">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE7C1;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="SeenButton" Click="OnSeenClick" Label="Als ungelesen markieren">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE715;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="SnoozeButton" Label="Später erinnern">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE823;" />
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout x:Name="SnoozeFlyout" Opening="OnSnoozeFlyoutOpening" />
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton x:Name="UnsubscribeButton" Click="OnUnsubscribeClick" Label="Abbestellen" Visibility="Collapsed">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8F8;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="SortButton" Label="Einsortieren"
                                      ToolTipService.ToolTip="Absender immer als … einsortieren">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8EC;" />
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout x:Name="SortFlyout" Opening="OnSortFlyoutOpening" />
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>

                    <!-- Hinweise: Phishing, Geplant, Erinnerung, externe Inhalte/Tracker -->
                    <StackPanel Grid.Row="2" Spacing="4">
                    <InfoBar x:Name="PhishingBar" Margin="24,4,24,0" IsClosable="True" IsOpen="False" Severity="Warning"
                             Title="Vorsicht: möglicher Phishing-Versuch" />
                    <Grid x:Name="ScheduledBar" Margin="24,4,24,0" Padding="12,8,8,8" Background="{ThemeResource LuSurfaceHover}"
                          CornerRadius="{StaticResource LuRadiusMedium}" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ScheduledText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Click="OnSendScheduledNowClick" Content="Jetzt senden" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="2" Click="OnDeleteScheduledClick" Content="Löschen" />
                    </Grid>
                    <Grid x:Name="ReminderBar" Margin="24,4,24,0" Padding="12,8,8,8" Background="{ThemeResource LuSurfaceHover}"
                          CornerRadius="{StaticResource LuRadiusMedium}" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ReminderText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LuTextSecondary}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Click="OnUnsnoozeClick" Content="Erinnerung aufheben" />
                    </Grid>
                    <Grid x:Name="ExternalBanner" Margin="24,4,24,4" Padding="12,8,8,8"
                          Background="{ThemeResource LuSurfaceHover}" CornerRadius="{StaticResource LuRadiusMedium}"
                          ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LuTextSecondary}" Glyph="&#xE72E;" />
                        <TextBlock x:Name="ExternalText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource LuTextSecondary}"
                                   Text="Externe Bilder und Inhalte wurden zum Schutz deiner Privatsphäre blockiert." TextWrapping="Wrap" />
                        <Button x:Name="LoadExternalButton" Grid.Column="2" Click="OnLoadExternalClick" Content="Externe Inhalte laden" />
                    </Grid>
                    </StackPanel>

                    <!-- Anhänge -->
                    <ScrollViewer x:Name="AttachmentsScroller" Grid.Row="3" Margin="24,2,24,4"
                                  HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" Visibility="Collapsed">
                        <StackPanel x:Name="AttachmentsPanel" Orientation="Horizontal" Spacing="8" />
                    </ScrollViewer>

                    <!-- Nachrichteninhalt -->
                    <Border Grid.Row="4" Margin="16,6,16,16" BorderBrush="{ThemeResource LuBorder}" BorderThickness="1"
                            CornerRadius="{StaticResource LuRadiusMedium}">
                        <Grid>
                            <WebView2 x:Name="ReaderView" />
                            <ProgressRing x:Name="ReaderLoading" Width="36" Height="36" IsActive="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Update- und Fehler-/Hinweisanzeige -->
        <StackPanel Grid.Row="1" MaxWidth="560" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8">
            <InfoBar x:Name="UpdateBar" IsClosable="True" IsOpen="False" Severity="Informational">
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Spacing="8">
                        <ProgressBar x:Name="UpdateProgress" Maximum="1" Minimum="0" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UpdatePrimaryButton" Click="OnUpdatePrimaryClick" Content="Jetzt neu starten"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="UpdateNotesButton" Click="OnUpdateNotesClick" Content="Was ist neu?" />
                        </StackPanel>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
            <InfoBar x:Name="MessageBar" IsClosable="True" IsOpen="False" Severity="Error" />
        </StackPanel>

        <!-- App-Sperre -->
        <Grid x:Name="LockOverlay" Grid.Row="0" Grid.RowSpan="2" Background="{ThemeResource LuBackground}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <FontIcon HorizontalAlignment="Center" FontSize="56" Foreground="{ThemeResource LuMoon}" Glyph="&#xE708;" />
                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource LuTextPrimary}"
                           Text="Lu-Mail ist gesperrt" />
                <Button HorizontalAlignment="Center" Click="OnUnlockClick" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72E;" />
                        <TextBlock Text="Mit Windows Hello entsperren" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
