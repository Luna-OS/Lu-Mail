<?xml version="1.0" encoding="utf-8"?>
<!--
  Lu-Mail – Theme „Luna“.
  Die Farbwerte entsprechen exakt shared/theme/lu-theme.json (Schlüssel "surfaceHover" → "LuSurfaceHover").
  Ein Unit-Test (ThemeTests.AppXamlColorsMatchLuTheme) prüft das bei jeder Änderung.
-->
<Application
    x:Class="LuMail.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LuBackground" Color="#F7F6FF" />
                    <SolidColorBrush x:Key="LuSidebar" Color="#EEECFB" />
                    <SolidColorBrush x:Key="LuSurface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LuSurfaceHover" Color="#F1EFFE" />
                    <SolidColorBrush x:Key="LuSurfaceSelected" Color="#E3DFFD" />
                    <SolidColorBrush x:Key="LuBorder" Color="#DDDAF2" />
                    <SolidColorBrush x:Key="LuTextPrimary" Color="#1B1A33" />
                    <SolidColorBrush x:Key="LuTextSecondary" Color="#5E5B80" />
                    <SolidColorBrush x:Key="LuTextMuted" Color="#9491B5" />
                    <SolidColorBrush x:Key="LuAccent" Color="#6B5BEF" />
                    <SolidColorBrush x:Key="LuAccentHover" Color="#5A49E0" />
                    <SolidColorBrush x:Key="LuAccentText" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LuMoon" Color="#C99A1E" />
                    <SolidColorBrush x:Key="LuUnreadDot" Color="#6B5BEF" />
                    <SolidColorBrush x:Key="LuDanger" Color="#E11D48" />
                    <SolidColorBrush x:Key="LuSuccess" Color="#16A34A" />
                </ResourceDictionary>
                <!-- "Default" wird für das dunkle Theme (und als Fallback für Kontrastdesigns) verwendet. -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LuBackground" Color="#0F1020" />
                    <SolidColorBrush x:Key="LuSidebar" Color="#131430" />
                    <SolidColorBrush x:Key="LuSurface" Color="#1A1C3A" />
                    <SolidColorBrush x:Key="LuSurfaceHover" Color="#232547" />
                    <SolidColorBrush x:Key="LuSurfaceSelected" Color="#2D2A5C" />
                    <SolidColorBrush x:Key="LuBorder" Color="#2A2C4F" />
                    <SolidColorBrush x:Key="LuTextPrimary" Color="#ECEBFF" />
                    <SolidColorBrush x:Key="LuTextSecondary" Color="#A6A3C9" />
                    <SolidColorBrush x:Key="LuTextMuted" Color="#6F6C99" />
                    <SolidColorBrush x:Key="LuAccent" Color="#8B7CFF" />
                    <SolidColorBrush x:Key="LuAccentHover" Color="#A094FF" />
                    <SolidColorBrush x:Key="LuAccentText" Color="#0F1020" />
                    <SolidColorBrush x:Key="LuMoon" Color="#F5D06F" />
                    <SolidColorBrush x:Key="LuUnreadDot" Color="#8B7CFF" />
                    <SolidColorBrush x:Key="LuDanger" Color="#FF6B81" />
                    <SolidColorBrush x:Key="LuSuccess" Color="#4ADE80" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Akzentfarbe der Standard-Steuerelemente an Luna anpassen
                 (helles Theme nutzt SystemAccentColorDark1, dunkles Theme SystemAccentColorLight2). -->
            <Color x:Key="SystemAccentColor">#7B6BF7</Color>
            <Color x:Key="SystemAccentColorDark1">#6B5BEF</Color>
            <Color x:Key="SystemAccentColorDark2">#5A49E0</Color>
            <Color x:Key="SystemAccentColorDark3">#4A3AC8</Color>
            <Color x:Key="SystemAccentColorLight1">#7D6DF7</Color>
            <Color x:Key="SystemAccentColorLight2">#8B7CFF</Color>
            <Color x:Key="SystemAccentColorLight3">#A094FF</Color>

            <!-- Anbieterfarben -->
            <SolidColorBrush x:Key="LuProviderGmail" Color="#EA4335" />
            <SolidColorBrush x:Key="LuProviderProton" Color="#6D4AFF" />
            <SolidColorBrush x:Key="LuProviderMailru" Color="#005FF9" />
            <SolidColorBrush x:Key="LuProviderHostinger" Color="#673DE6" />
            <SolidColorBrush x:Key="LuProviderOutlook" Color="#0A64D8" />
            <SolidColorBrush x:Key="LuProviderIcloud" Color="#3693F3" />
            <SolidColorBrush x:Key="LuProviderGmx" Color="#1C449B" />
            <SolidColorBrush x:Key="LuProviderWebde" Color="#E5B800" />
            <SolidColorBrush x:Key="LuProviderYandex" Color="#FC3F1D" />
            <SolidColorBrush x:Key="LuProviderCustom" Color="#8B7CFF" />

            <!-- Kategoriefarben -->
            <SolidColorBrush x:Key="LuCategoryPrimary" Color="#8B7CFF" />
            <SolidColorBrush x:Key="LuCategoryPromotions" Color="#F59E0B" />
            <SolidColorBrush x:Key="LuCategorySocial" Color="#3B82F6" />
            <SolidColorBrush x:Key="LuCategoryUpdates" Color="#10B981" />
            <SolidColorBrush x:Key="LuCategoryForums" Color="#A855F7" />

            <!-- Radien -->
            <CornerRadius x:Key="LuRadiusSmall">6</CornerRadius>
            <CornerRadius x:Key="LuRadiusMedium">10</CornerRadius>
            <CornerRadius x:Key="LuRadiusLarge">16</CornerRadius>

            <FontFamily x:Key="LuFontFamily">Segoe UI Variable</FontFamily>
            <SolidColorBrush x:Key="LuTransparent" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
